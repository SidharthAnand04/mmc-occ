---
import { services } from '../data/site';
import Icon from './Icon.astro';
---

<div class="service-grid">
  {services.map((s, i) => (
    <a class="service-card" href={`/services/${s.slug}/`}>
      <div class="card-top">
        <span class="icon-box">
          <Icon name={s.icon} />
        </span>
        <span class="index">0{i + 1}</span>
      </div>
      <h3>{s.title}</h3>
      <p>{s.description}</p>
      <span class="card-link">
        Explore service <Icon name="arrow" />
      </span>
    </a>
  ))}
</div>
