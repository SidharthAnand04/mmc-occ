---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Locations from '../../components/Locations.astro';
import { telephone, phone } from '../../data/site';
---

<Layout title="Clinic Locations & Hours">
  <PageHero
    title="Local care. Close to work."
    eyebrow="EAGAN · MAPLEWOOD · PLYMOUTH"
    description="Find addresses, clinic hours, and directions for My Medical Clinic’s three Twin Cities locations."
  />
  <section class="section wrap">
    <Locations />
    <div class="callout">
      <h3>Coming in for testing?</h3>
      <p>
        Drug screening walk-ins end at 3 pm. EScreen collection at Eagan and
        Maplewood is listed as 9 am–3 pm. Please{' '}
        <a class="text-link" href={telephone}>
          call {phone}
        </a>{' '}
        to confirm the service and collection window before visiting.
      </p>
    </div>
  </section>
</Layout>
