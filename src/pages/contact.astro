---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { phone, telephone, email, appointment } from '../data/site';
const subject = encodeURIComponent(
  'Employer services inquiry – My Medical Clinic',
);
---

<Layout title="Contact MMC | Employer Onboarding">
  <PageHero
    title="Let’s care for your workforce."
    eyebrow="EMPLOYER ONBOARDING & CONTACT"
    description="Tell us what your company needs. Call or email My Medical Clinic to discuss services and establish your employer relationship."
  />
  <section class="section wrap content-grid">
    <div class="contact-options">
      <article class="contact-option">
        <p class="eyebrow">CALL OUR TEAM</p>
        <h2>
          <a href={telephone}>{phone}</a>
        </h2>
        <p>
          Discuss services, clinic availability, and the next steps for your
          employees.
        </p>
        <a class="text-link" href="/locations/">
          View clinic hours →
        </a>
      </article>
      <article class="contact-option">
        <p class="eyebrow">EMAIL AN EMPLOYER INQUIRY</p>
        <h3>Introduce your company.</h3>
        <p>
          Include your company name, business contact details, worksite
          location, and services of interest. Please do not include employee
          medical information in email.
        </p>
        <a class="text-link" href={`mailto:${email}?subject=${subject}`}>
          {email} ↗
        </a>
        <p class="fineprint">
          Opens your email app. No inquiry is submitted through this website.
        </p>
      </article>
    </div>
    <aside class="side-panel">
      <h2>Before your first employee visit</h2>
      <p>Ask our team to confirm:</p>
      <ul>
        <li>Services and clinic location</li>
        <li>Scheduling and collection hours</li>
        <li>Employer authorization requirements</li>
        <li>Billing arrangements and pricing</li>
      </ul>
      <a class="text-link" href="/former-moh-clients/">
        Former MOH clients →
      </a>
      <hr />
      <h3>Scheduling for yourself?</h3>
      <a class="button" href={appointment}>
        Request an appointment
      </a>
    </aside>
  </section>
</Layout>
