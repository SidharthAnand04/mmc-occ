---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
---

<Layout title="Employer Healthcare Services">
  <PageHero
    title="A healthcare partner for your workforce."
    eyebrow="FOR EMPLOYERS"
    description="Bring your occupational health needs to a physician-owned clinic. Work with MMC to discuss a program built around your employees and workplace."
  />
  <section class="section wrap content-grid">
    <div class="prose">
      <h2>Let’s start with your business.</h2>
      <p>
        Whether you are arranging a pre-employment exam or looking for workplace
        injury care, our team can help you discuss the next steps.
      </p>
      <div class="steps">
        <div class="step">
          <div>
            <h3>Tell us what you need</h3>
            <p>
              Share your company name, primary contact, worksite location, and
              the services you are looking for.
            </p>
          </div>
        </div>
        <div class="step">
          <div>
            <h3>Discuss your service plan</h3>
            <p>
              Ask about clinic access, on-site options, scheduling, pricing, and
              required authorizations.
            </p>
          </div>
        </div>
        <div class="step">
          <div>
            <h3>Confirm before the first visit</h3>
            <p>
              Work with MMC to confirm arrangements before sending employees for
              care.
            </p>
          </div>
        </div>
      </div>
    </div>
    <aside class="side-panel">
      <p class="eyebrow">NEW EMPLOYER?</p>
      <h2>Start the conversation.</h2>
      <p>Contact our team to discuss setting up services for your company.</p>
      <a class="button" href="/contact/">
        Connect with MMC ↗
      </a>
      <a class="text-link" href="/former-moh-clients/">
        Coming from MOH? →
      </a>
    </aside>
  </section>
  <section class="employer-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SUPPORT FOR YOUR TEAM</p>
          <h2>Find the services you need.</h2>
        </div>
      </div>
      <ServiceGrid limit={6} />
    </div>
  </section>
</Layout>
