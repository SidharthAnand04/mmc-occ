---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Locations from '../components/Locations.astro';
import { appointment, telephone, phone } from '../data/site';
export function getStaticPaths() {
  return [
    {
      slug: 'create-account',
      title: 'Partner with My Medical Clinic',
      sub: 'EMPLOYER ACCOUNT SETUP',
      description:
        'Start a conversation about setting up occupational healthcare for your company.',
      kind: 'form',
    },
    {
      slug: 'inquiry-of-services',
      title: 'Inquire about our services',
      sub: 'CONTACT MMC',
      description:
        'Tell us about your workforce and the care you are looking for.',
      kind: 'form',
    },
    {
      slug: 'request-appointment',
      title: 'Request an appointment',
      sub: 'PLAN YOUR VISIT',
      description:
        'Connect with the clinic to arrange care at Eagan, Maplewood, or Plymouth.',
      kind: 'appointment',
    },
    {
      slug: 'health-information-release-authorization-form',
      title: 'Release of health information',
      sub: 'PATIENT RESOURCES',
      description:
        'Find MMC’s authorization form and ask the clinic about the appropriate records process.',
      kind: 'records',
    },
    {
      slug: 'pay-my-bill',
      title: 'Pay your bill',
      sub: 'BILLING & PAYMENTS',
      description:
        'Use MMC’s existing payment page or call with billing questions.',
      kind: 'payment',
    },
    {
      slug: 'privacy',
      title: 'Privacy & your health information',
      sub: 'PATIENT RESOURCES',
      description:
        'Read My Medical Clinic’s published privacy notice and contact the clinic with questions.',
      kind: 'privacy',
    },
    {
      slug: 'patient-forms',
      title: 'Patient forms',
      sub: 'PREPARE FOR YOUR VISIT',
      description:
        'Access the existing MMC forms relevant to your appointment.',
      kind: 'records',
    },
  ].map((page) => ({ params: { page: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---

<Layout title={page.title}>
  <PageHero
    title={page.title}
    eyebrow={page.sub}
    description={page.description}
  />
  <section class="section wrap content-grid">
    <div class="prose">
      {page.kind === 'form' && (
        <>
          <h2>Tell us about your company.</h2>
          <InquiryForm kind={page.sub} />
        </>
      )}
      {page.kind === 'appointment' && (
        <>
          <h2>Arrange the right visit.</h2>
          <p>
            Use MMC’s existing appointment request page or call the clinic.
            Please confirm your appointment before arriving.
          </p>
          <div class="actions">
            <a class="button" href={appointment}>
              Open appointment request →
            </a>
            <a class="text-link" href={telephone}>
              Call {phone}
            </a>
          </div>
          <h3>Before you request</h3>
          <ul>
            <li>Know the service requested by your employer.</li>
            <li>Choose your preferred clinic.</li>
            <li>
              Ask about required forms and service-specific collection hours.
            </li>
          </ul>
          <p>An appointment request is not a confirmed booking.</p>
        </>
      )}
      {page.kind === 'records' && (
        <>
          <h2>Forms from My Medical Clinic.</h2>
          <div class="resource-list">
            <a
              class="resource-link"
              href="https://mymedicalclinicmn.com/wp-content/uploads/2024/11/release-of-information.pdf"
            >
              Release of information authorization <span>PDF ↗</span>
            </a>
            <a
              class="resource-link"
              href="https://mymedicalclinicmn.com/wp-content/uploads/2024/11/patient-package.pdf"
            >
              Patient packet <span>PDF ↗</span>
            </a>
            <a
              class="resource-link"
              href="https://mymedicalclinicmn.com/patient-forms/"
            >
              All current MMC forms <span>Open ↗</span>
            </a>
          </div>
          <div class="callout">
            <h3>Sending medical records?</h3>
            <p>
              Ask MMC for the correct authorization and secure transfer
              instructions. Do not upload or email medical records through the
              employer inquiry form.
            </p>
          </div>
        </>
      )}
      {page.kind === 'payment' && (
        <>
          <h2>Continue to MMC’s payment page.</h2>
          <p>
            The payment link opens the Clover destination published on MMC’s
            current website. Have your billing information ready.
          </p>
          <a class="button" href="https://link.clover.com/urlshortener/hy6BGn">
            Open payment page →
          </a>
          <h3>Questions about a bill?</h3>
          <p>
            Call {phone} to discuss your statement or payment options with the
            clinic.
          </p>
        </>
      )}
      {page.kind === 'privacy' && (
        <>
          <h2>Read MMC’s privacy notice.</h2>
          <p>
            My Medical Clinic’s existing website publishes its notice about
            medical information and patient privacy.
          </p>
          <a
            class="button"
            href="https://mymedicalclinicmn.com/privacy-policy/"
          >
            Read the privacy notice →
          </a>
          <h3>Questions or records requests</h3>
          <p>
            Please contact the clinic for help with the notice or a request
            concerning your health information.
          </p>
          <a
            class="text-link"
            href="/health-information-release-authorization-form/"
          >
            Records authorization →
          </a>
        </>
      )}
    </div>
    <aside class="side-panel">
      <h2>We’re here to help.</h2>
      <p>Call our team for services, scheduling, and account questions.</p>
      <a class="button" href={telephone}>
        {phone}
      </a>
      <div class="service-sidebar">
        <a href="/locations/">Clinic locations & hours</a>
        <a href="/former-moh-clients/">Former MOH clients</a>
        <a href="/resources/">Patient resources</a>
      </div>
    </aside>
  </section>
  {page.kind === 'form' && (
    <section class="section wrap">
      <Locations />
    </section>
  )}
</Layout>
