---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { team, telephone } from '../../data/site';
export function getStaticPaths() {
  return team.map((person) => ({
    params: { slug: person[0].toLowerCase().replaceAll(' ', '-') },
    props: { person },
  }));
}
const { person } = Astro.props;
const [name, credentials, role, description] = person;
---

<Layout title={`${name}, ${credentials}`}>
  <PageHero
    title={name}
    eyebrow={credentials}
    description={role}
    parent={{ title: 'Our team', href: '/team/' }}
  />
  <section class="section wrap profile-layout">
    <div class="initials" aria-hidden="true">
      {name
        .split(' ')
        .map((n) => n[0])
        .join('')}
    </div>
    <div class="prose">
      <h2>{role}</h2>
      {description && <p>{description}</p>}
      <p>
        {name} is listed on My Medical Clinic’s clinical team. Contact the
        clinic to discuss your care needs and confirm provider availability.
      </p>
      <div class="actions">
        <a class="button" href={telephone}>
          Contact the clinic
        </a>
        <a class="text-link" href="/request-appointment/">
          Arrange a visit →
        </a>
      </div>
    </div>
  </section>
</Layout>
