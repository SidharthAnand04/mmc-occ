---
import Layout from '../layouts/Layout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Locations from '../components/Locations.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Occupational Health & Employer Services">
  <section class="reference-hero">
    <img
      class="banner-photo"
      src="/images/moh-style-banner.webp"
      width="1800"
      height="792"
      alt="Three construction workers wearing safety equipment"
      fetchpriority="high"
    />
    <div class="wrap banner-inner">
      <div class="banner-panel">
        <h1>
          Occupational health.
          <br />
          Built around
          <br />
          your workforce.
        </h1>
        <p>
          In-clinic and on-site care for employers and employees across the Twin
          Cities.
        </p>
        <a class="button" href="/create-account/">
          Partner with MMC →
        </a>
      </div>
    </div>
  </section>
  <section class="reference-shortcuts wrap">
    <a href="/request-appointment/">
      <Icon name="clipboard" />
      <h2>Request an appointment</h2>
      <p>Plan an employee visit at one of our three clinic locations.</p>
      <span class="text-link">Arrange your visit →</span>
    </a>
    <a href="/employers/">
      <Icon name="building" />
      <h2>Employer services</h2>
      <p>
        Find care for workplace injuries, physicals, and employee screenings.
      </p>
      <span class="text-link">Explore services →</span>
    </a>
    <a href="/team/">
      <Icon name="heart" />
      <h2>Meet your clinical team</h2>
      <p>Get to know the people behind My Medical Clinic.</p>
      <span class="text-link">Meet our team →</span>
    </a>
  </section>
  <section class="section reference-services">
    <div class="wrap">
      <div class="center-heading">
        <h2>
          Occupational healthcare
          <br />
          for your business’s needs.
        </h2>
        <p>
          Connect your workforce with the services they need, from
          pre-employment screening to workplace injury care.
        </p>
      </div>
      <ServiceGrid photos limit={8} />
      <div class="center-action">
        <a class="button" href="/services/">
          Explore all services →
        </a>
      </div>
    </div>
  </section>
  <section class="section wrap reference-split">
    <div>
      <h2>
        A local partner
        <br />
        in employee health.
      </h2>
      <p>
        My Medical Clinic combines occupational medicine and general healthcare
        with a personal connection to employers and employees.
      </p>
      <p>
        Discuss a plan around your workplace’s needs, with clinic locations in
        Eagan, Maplewood, and Plymouth.
      </p>
      <a class="button" href="/employers/">
        Work with our team →
      </a>
    </div>
    <img
      src="/images/consultation.webp"
      alt="Illustrative photograph of a patient greeting a clinician"
      width="1000"
      height="667"
      loading="lazy"
    />
  </section>
  <section class="reference-blue">
    <div class="wrap reference-split">
      <div>
        <h2>
          Care after a<br />
          workplace injury.
        </h2>
        <p>
          Connect with MMC for injury evaluation, treatment, and return-to-work
          planning.
        </p>
        <p>
          Our physicians communicate with employees and employers about the
          course of care.
        </p>
        <a class="button white" href="/services/work-injury-care/">
          Work injury care →
        </a>
      </div>
      <div class="blue-list">
        <a href="/services/pre-employment-screening/">
          Pre-employment screening <span>→</span>
        </a>
        <a href="/services/dot-physical-exams/">
          DOT physical exams <span>→</span>
        </a>
        <a href="/services/drug-alcohol-testing/">
          Drug & alcohol testing <span>→</span>
        </a>
        <a href="/services/on-site-programs/">
          On-site programs <span>→</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="center-heading">
      <h2>Find your MMC clinic.</h2>
      <p>Three locations serving the Twin Cities metro area.</p>
    </div>
    <Locations />
  </section>
  <section class="reference-welcome">
    <div class="wrap">
      <h2>
        Former Minnesota
        <br />
        Occupational Health client?
      </h2>
      <p>
        Welcome to My Medical Clinic. Let’s discuss your company’s healthcare
        needs and establish your services with our team.
      </p>
      <a class="button" href="/former-moh-clients/">
        Get started with MMC →
      </a>
    </div>
  </section>
</Layout>
