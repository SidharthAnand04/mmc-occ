---
import Layout from '../layouts/Layout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Locations from '../components/Locations.astro';
import Icon from '../components/Icon.astro';
import { appointment } from '../data/site';
---

<Layout title="Occupational Medicine & Employer Healthcare">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="tiny-line"></span> YOUR PEOPLE. OUR PRIORITY.
        </p>
        <h1>
          Care that keeps
          <br />
          your workforce
          <br />
          <em>moving forward.</em>
        </h1>
        <p class="lead">
          Occupational medicine with a personal connection. In-clinic and
          on-site care for employers and employees across the Twin Cities.
        </p>
        <div class="actions">
          <a class="button" href="/employers/">
            Explore employer services <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/locations/">
            Find a clinic <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-proof">
          <span>Physician-owned</span>
          <span>Locally focused</span>
          <span>Three clinic locations</span>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/images/workforce.webp"
          alt="Worker wearing a hard hat and safety glasses at a construction site"
          width="1200"
          height="707"
          fetchpriority="high"
        />
        <div class="photo-caption">
          <span class="icon-box">
            <Icon name="heart" />
          </span>
          <div>
            <strong>Built around your people.</strong>
            <span>At work. In the clinic. Every step.</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="quick-strip">
    <div class="wrap quick-grid">
      <a href="/services/work-injury-care/">
        <span class="icon-box">
          <Icon />
        </span>
        <div>
          <strong>Need work injury care?</strong>
          <span>Connect with our clinic</span>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={appointment}>
        <span class="icon-box">
          <Icon name="clipboard" />
        </span>
        <div>
          <strong>Planning an employee visit?</strong>
          <span>Request an appointment</span>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/contact/">
        <span class="icon-box">
          <Icon name="building" />
        </span>
        <div>
          <strong>New to My Medical Clinic?</strong>
          <span>Set up employer services</span>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">OCCUPATIONAL HEALTH SERVICES</p>
        <h2>
          The right care.
          <br />
          For the work you do.
        </h2>
      </div>
      <p>
        From a new hire’s first physical to care after a workplace injury, find
        support for the health needs of your team.
      </p>
    </div>
    <ServiceGrid />
  </section>
  <section class="employer-section">
    <div class="wrap employer-grid">
      <div>
        <p class="eyebrow">A PARTNER FOR EMPLOYERS</p>
        <h2>
          Your business is unique.
          <br />
          Your care should be, too.
        </h2>
        <p class="lead">
          Work directly with a physician-owned clinic to discuss a healthcare
          program that fits your workforce.
        </p>
        <a class="button" href="/employers/">
          How we work with employers <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="benefits">
        <div>
          <span>01</span>
          <div>
            <h3>Start with your needs</h3>
            <p>
              Tell us about your roles, work environment, and employee health
              requirements.
            </p>
          </div>
        </div>
        <div>
          <span>02</span>
          <div>
            <h3>Connect care and work</h3>
            <p>
              Coordinate injury care, physicals, and screenings with the MMC
              team.
            </p>
          </div>
        </div>
        <div>
          <span>03</span>
          <div>
            <h3>Keep the conversation going</h3>
            <p>
              Discuss treatment and return-to-work plans with clinicians who
              understand occupational health.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">CLOSE TO YOUR WORKPLACE</p>
        <h2>
          Three clinics.
          <br />
          One connected team.
        </h2>
      </div>
      <div>
        <p>Find My Medical Clinic in Eagan, Maplewood, and Plymouth.</p>
        <a class="text-link" href="/locations/">
          All locations & hours <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <Locations />
    <p class="fineprint">
      Drug screening walk-ins end at 3 pm. Collection hours vary by service;
      please call before visiting.
    </p>
  </section>
  <section class="wrap moh-panel">
    <div>
      <p class="eyebrow">FORMER MINNESOTA OCCUPATIONAL HEALTH CLIENTS</p>
      <h2>
        A welcome place
        <br />
        for your next chapter.
      </h2>
    </div>
    <div>
      <p>
        Looking to establish care with MMC? Our team can help you discuss your
        company’s occupational health needs and the next steps.
      </p>
      <a class="text-link" href="/former-moh-clients/">
        Start your conversation <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
