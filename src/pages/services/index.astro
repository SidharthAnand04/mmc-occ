---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/site';
---

<Layout title="Occupational Medicine Services">
  <PageHero
    title="Services for a healthier workforce."
    eyebrow="OCCUPATIONAL MEDICINE"
    description="Find clinical services and on-site programs for your employees. Explore individual services or contact MMC to discuss your workplace requirements."
  />
  <section class="section wrap">
    <div class="directory-tools">
      <label for="service-search">Find a service</label>
      <input id="service-search" type="search" placeholder="Search services" />
      <label for="service-group">Category</label>
      <select id="service-group">
        <option value="all">All confirmed services</option>
        <option value="Clinical services">Clinical services</option>
        <option value="On-site programs">On-site programs</option>
      </select>
    </div>
    <p class="directory-count" role="status" id="service-count">
      {services.filter((s) => !s.inquiry).length} services
    </p>
    <div class="service-grid" id="service-directory">
      {services
        .filter((s) => !s.inquiry)
        .map((s) => (
          <a
            class="service-card"
            data-service-title={s.title.toLowerCase()}
            data-service-group={s.group || 'Clinical services'}
            href={`/services/${s.slug}/`}
          >
            <div class="service-body">
              <h2>{s.title}</h2>
              <p>{s.description}</p>
              <span class="card-link">Learn more →</span>
            </div>
          </a>
        ))}
    </div>
    <p id="no-services" hidden>
      No matching services. Try another search, or contact the clinic.
    </p>
    <section class="inquiry-list">
      <h2>Additional service inquiries</h2>
      <p>
        These topics appear in the former MOH service directory. Please confirm
        MMC availability before booking.
      </p>
      <div class="inquiry-links">
        {services
          .filter((s) => s.inquiry)
          .map((s) => (
            <a href={`/services/${s.slug}/`}>
              {s.title}
              <small>Ask about availability →</small>
            </a>
          ))}
      </div>
    </section>
  </section>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#service-search');
  const group = document.querySelector<HTMLSelectElement>('#service-group');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(
      '#service-directory [data-service-title]',
    ),
  );
  function filter() {
    let count = 0;
    for (const card of cards) {
      const shown =
        (card.dataset.serviceTitle || '').includes(
          search?.value.toLowerCase().trim() || '',
        ) &&
        (group?.value === 'all' || card.dataset.serviceGroup === group?.value);
      card.hidden = !shown;
      if (shown) count++;
    }
    const status = document.querySelector('#service-count');
    if (status)
      status.textContent = `${count} service${count === 1 ? '' : 's'}`;
    const empty = document.querySelector<HTMLElement>('#no-services');
    if (empty) empty.hidden = count !== 0;
  }
  search?.addEventListener('input', filter);
  group?.addEventListener('change', filter);
</script>
