---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { services, telephone, phone, appointment } from '../../data/site';
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
---

<Layout
  title={`${service.title} in the Twin Cities`}
  description={service.description}
>
  <PageHero
    title={service.title}
    eyebrow="OCCUPATIONAL HEALTH SERVICES"
    description={service.description}
    parent={{ title: 'Services', href: '/services/' }}
  />
  <section class="section wrap content-grid">
    <div class="prose">
      <p class="eyebrow">CARE WITH A PURPOSE</p>
      <h2>{service.short}</h2>
      <ul class="check-list">
        {service.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <div class="callout">
        <h3>Before your visit</h3>
        <p>{service.note}</p>
      </div>
      <h3>Plan care with your team</h3>
      <p>
        For an employer-directed visit, contact us to confirm the requested
        service, clinic, and any paperwork needed before your employee arrives.
      </p>
      <a class="text-link" href="/locations/">
        Find a clinic & view hours <span aria-hidden="true">→</span>
      </a>
      <h3>Related services</h3>
      <div class="service-nav">
        {services
          .filter((s) => s.slug !== service.slug)
          .slice(0, 3)
          .map((s) => (
            <a href={`/services/${s.slug}/`}>{s.title}</a>
          ))}
      </div>
    </div>
    <aside class="side-panel">
      <p class="eyebrow">LET’S GET YOU CONNECTED</p>
      <h2>Arrange the right care.</h2>
      <p>Our clinic team can help with scheduling and service questions.</p>
      <a class="button" href={telephone}>
        Call {phone}
      </a>
      <a class="button outline" href={appointment}>
        Request an appointment
      </a>
      <a class="text-link" href="/contact/">
        Discuss employer services →
      </a>
    </aside>
  </section>
</Layout>
