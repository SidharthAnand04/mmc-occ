---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { phone, telephone, email } from '../data/site';
---

<Layout title="Former Minnesota Occupational Health Clients">
  <PageHero
    title="Welcome to My Medical Clinic."
    eyebrow="FORMER MINNESOTA OCCUPATIONAL HEALTH CLIENTS"
    description="If your company previously used Minnesota Occupational Health, contact MMC to discuss establishing services with our team."
  />
  <section class="section wrap content-grid">
    <div class="prose">
      <h2>Your next step starts here.</h2>
      <p>
        Let us know that you are a former MOH client and tell us about your
        workplace health needs.
      </p>
      <div class="steps">
        <div class="step">
          <div>
            <h3>Introduce your company</h3>
            <p>Share your business contact and the services you need.</p>
          </div>
        </div>
        <div class="step">
          <div>
            <h3>Confirm your arrangements</h3>
            <p>
              Discuss provider availability, clinic locations, scheduling, and
              billing with MMC.
            </p>
          </div>
        </div>
        <div class="step">
          <div>
            <h3>Ask about records</h3>
            <p>
              Before sending any employee records, ask our team about
              appropriate authorization and transfer instructions.
            </p>
          </div>
        </div>
      </div>
      <div class="callout">
        <p>
          Please confirm your setup with MMC before directing employees to a
          clinic. Do not assume previous accounts, authorizations, or medical
          records have transferred automatically.
        </p>
      </div>
      <a class="text-link" href="/locations/">
        Explore MMC locations →
      </a>
    </div>
    <aside class="side-panel">
      <h2>We’re ready to talk.</h2>
      <p>Call or email to establish services with My Medical Clinic.</p>
      <a class="button" href={telephone}>
        Call {phone}
      </a>
      <a
        class="button outline"
        href={`mailto:${email}?subject=Former%20MOH%20client%20inquiry`}
      >
        Email MMC
      </a>
    </aside>
  </section>
</Layout>
