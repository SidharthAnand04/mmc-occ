---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { appointment, telephone, phone } from '../data/site';
const resources = [
  ['Pay my bill', 'https://link.clover.com/urlshortener/hy6BGn', 'Open ↗'],
  [
    'Patient packet',
    'https://mymedicalclinicmn.com/wp-content/uploads/2024/11/patient-package.pdf',
    'PDF ↗',
  ],
  [
    'Release of health information',
    'https://mymedicalclinicmn.com/wp-content/uploads/2024/11/release-of-information.pdf',
    'PDF ↗',
  ],
  [
    'All patient forms',
    'https://mymedicalclinicmn.com/patient-forms/',
    'Open ↗',
  ],
  [
    'Patient referrals',
    'https://mymedicalclinicmn.com/urgency-room-referrals/',
    'Open ↗',
  ],
  ['Privacy policy', 'https://mymedicalclinicmn.com/privacy-policy/', 'Open ↗'],
];
---

<Layout title="Patient Forms & Resources">
  <PageHero
    title="Make your next visit easier."
    eyebrow="PATIENT RESOURCES"
    description="Find existing MMC forms, request an appointment, and prepare for a visit to your clinic."
  />
  <section class="section wrap content-grid">
    <div class="prose">
      <h2>Forms & useful links</h2>
      <p>
        These links open MMC’s existing resources. Ask the clinic which forms
        apply to your visit.
      </p>
      <div class="resource-list">
        {resources.map(([title, url, label]) => (
          <a class="resource-link" href={url}>
            {title}
            <span>{label}</span>
          </a>
        ))}
      </div>
      <h3>Questions before your visit</h3>
      <details>
        <summary>How do I arrange an appointment?</summary>
        <p>
          Call {phone} or use MMC’s existing appointment request page. An
          appointment request is not a confirmed booking.
        </p>
      </details>
      <details>
        <summary>What if my employer is sending me?</summary>
        <p>
          Ask your employer which service is required, then contact MMC to
          confirm the location and any paperwork needed.
        </p>
      </details>
      <details>
        <summary>When can I come for drug screening?</summary>
        <p>
          Drug screening walk-ins end at 3 pm. EScreen collection at Eagan and
          Maplewood is listed as 9 am–3 pm. Call to confirm testing availability
          before arriving.
        </p>
      </details>
      <h3>Looking for general medical care?</h3>
      <p>
        MMC also provides general medicine services. Visit the existing patient
        page for details on care beyond occupational health.
      </p>
      <a class="text-link" href="https://mymedicalclinicmn.com/for-patients/">
        View MMC patient information ↗
      </a>
    </div>
    <aside class="side-panel">
      <h2>Ready for your visit?</h2>
      <a class="button" href={appointment}>
        Request an appointment
      </a>
      <a class="button outline" href={telephone}>
        Call {phone}
      </a>
      <p>To discuss a bill or payment options, please call the clinic.</p>
      <a class="text-link" href="/locations/">
        Locations & hours →
      </a>
    </aside>
  </section>
</Layout>
